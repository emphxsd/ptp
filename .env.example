# Настройки для запуска в Docker (docker-compose.yml). start.bat создаёт .env сам, со случайными паролями;
# этот файл — для справки. Файл .env в git не попадает.

# ключ шифрования сессий Laravel: base64: и 32 случайных байта
APP_KEY=
# пароль базы PostgreSQL внутри Docker (наружу база не открыта)
DB_PASSWORD=
# общий секрет сайта и сервиса обработки
PROCESSOR_API_TOKEN=
# адрес сайта: http://localhost:8000
WEB_PORT=8000
# локальная LLM (Ollama) в Docker: true — включить; на ноутбуке без видеокарты отвечает 20–60 с
LLM_ENABLED=false
# qwen2.5:3b (~2 ГБ) — для слабого компьютера; qwen2.5:7b (~4,7 ГБ) — точнее, нужна видеокарта
LLM_MODEL=qwen2.5:3b
