# Скопируйте в .env и при необходимости измените значения. Файл .env в git не попадает.

# Режим: development | production. В production токен обязателен, документация API отключена.
PROCESSOR_ENV=development

# Токен для межсервисных вызовов: если задан, /extract требует заголовок
# "Authorization: Bearer <токен>". Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
PROCESSOR_API_TOKEN=

# Документация API (/docs, /openapi.json). В продакшене — false.
PROCESSOR_DOCS_ENABLED=true

# Лимиты
PROCESSOR_MAX_FILE_MB=20
PROCESSOR_MAX_PAGES=300
PROCESSOR_MAX_TEXT_CHARS=2000000
PROCESSOR_MAX_TEMPLATE_CHARS=65536
PROCESSOR_DOCX_MAX_TABLE_ROWS=5000

# Этап NER (Natasha). false — только правила (для сравнения подходов)
PROCESSOR_NER_ENABLED=true

# Порог уверенности: значения ниже помечаются «требует проверки» (0..1)
PROCESSOR_REVIEW_THRESHOLD=0.6

# Минимум «значимых» символов на страницу PDF, чтобы она считалась текстовой, а не сканом
PROCESSOR_MIN_CHARS_PER_PAGE=20

# Этап LLM. ollama — локальная модель: документ не покидает компьютер (рекомендуется для документов
# с персональными данными). gigachat — облачный сервис Сбера, нужен ключ ниже.
PROCESSOR_LLM_PROVIDER=ollama
# Ollama (https://ollama.com): установить, затем `ollama pull qwen2.5:7b`. По http — только 127.0.0.1 или [::1]
PROCESSOR_OLLAMA_URL=http://127.0.0.1:11434
PROCESSOR_OLLAMA_MODEL=qwen2.5:7b
# окно модели в токенах: должно вмещать LLM_MAX_INPUT_CHARS символов документа и описание полей
PROCESSOR_OLLAMA_NUM_CTX=8192
# сколько модель держится в видеопамяти после запроса (30m, 1h; -1 — всегда)
PROCESSOR_OLLAMA_KEEP_ALIVE=30m

# GigaChat (если PROCESSOR_LLM_PROVIDER=gigachat). Без ключа этап не работает — сервис использует правила и NER.
# Ключ: developers.sber.ru → проект GigaChat API → Authorization key. Никогда не коммитить!
PROCESSOR_GIGACHAT_AUTH_KEY=
# Корневой сертификат Минцифры (https://www.gosuslugi.ru/crt), путь относительно processor/
PROCESSOR_GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.pem
# GIGACHAT_API_PERS — физлица; GIGACHAT_API_B2B / GIGACHAT_API_CORP — ИП и юрлица
PROCESSOR_GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GigaChat-2 (Lite) | GigaChat-2-Pro | GigaChat-2-Max
PROCESSOR_GIGACHAT_MODEL=GigaChat-2-Pro
# false — отключить LLM (для сравнения подходов)
PROCESSOR_LLM_ENABLED=true
PROCESSOR_LLM_TIMEOUT_SECONDS=20
PROCESSOR_LLM_MAX_INPUT_CHARS=12000
PROCESSOR_LLM_MAX_OUTPUT_TOKENS=1024

# OCR сканов (Tesseract). Установщик для Windows: https://github.com/UB-Mannheim/tesseract/wiki
# (при установке отметить язык Russian). Если Tesseract есть в PATH — достаточно "tesseract".
PROCESSOR_OCR_ENABLED=true
PROCESSOR_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
PROCESSOR_OCR_LANGUAGES=rus+eng
PROCESSOR_OCR_DPI=300
PROCESSOR_OCR_MAX_PAGES=20
PROCESSOR_OCR_TIMEOUT_SECONDS=20
PROCESSOR_OCR_MIN_CONFIDENCE=60

# Общий срок обработки документа (OCR и LLM делят его); LLM пропускается, если осталось меньше LLM_MIN_SECONDS
PROCESSOR_PROCESSING_BUDGET_SECONDS=30
PROCESSOR_LLM_MIN_SECONDS=5
PROCESSOR_OCR_MAX_PIXELS=25000000
