{
  "_comment": "Общие случаи для web (UserRegex — быстрая проверка в форме) и processor (RE2). valid — принимают оба; rejected — отклоняют оба; too_complex — принимает форма, отклоняет только сервис (предел сложности программы RE2), поэтому поле с регулярным выражением сохраняется только после проверки сервисом.",
  "valid": [
    "(\\d+)",
    "[А-Яа-яЁё]+",
    "(?i)итого",
    "(?P<value>\\d+)",
    "\\d{10}|\\d{12}",
    "\\p{Cyrillic}+",
    "[^\\s]+",
    "\\d+\\z",
    "(?s)Итого.+",
    "[\\w.+-]+@[\\w-]+\\.[\\w.]+",
    "№\\s*(\\d+)",
    "\\d{2}\\.\\d{2}\\.\\d{4}"
  ],
  "rejected": [
    "a++",
    "\\G\\d",
    "\\K\\d",
    "\\R",
    "\\h+",
    "\\X",
    "\\d+\\Z",
    "(?R)?a",
    "(a)(?1)",
    "(?|a|b)",
    "(*UTF)a",
    "(a)(?(1)a|b)",
    "(\\d)\\g-1",
    "(?P<n>a)(?P>n)",
    "\\d+(?#comment)",
    "(?=\\d)\\d+",
    "(?<!a)b",
    "(\\d)\\1",
    "(?>a+)b",
    "\\N",
    "\\e",
    "\\Ca",
    "\\d*",
    "^",
    "([0-9]"
  ],
  "too_complex": [
    "\\pL+",
    "[А-Яа-яЁё]{1,100}",
    "\\d{1000}"
  ]
}
