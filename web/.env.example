APP_NAME="Извлечение данных"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (как в схемах проекта). Пароль — только в .env, в git не попадает.
# До установки PostgreSQL можно временно работать на SQLite: DB_CONNECTION=sqlite
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=docextract
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Срок хранения журнала действий (там IP-адреса), дней
AUDIT_RETENTION_DAYS=365

# Сервис обработки документов (../processor, запуск на порту 8001).
# PROCESSOR_API_TOKEN — тот же, что в processor/.env; пустой — без токена (только для локальной разработки)
PROCESSOR_URL=http://127.0.0.1:8001
PROCESSOR_API_TOKEN=
PROCESSOR_TIMEOUT=10
PROCESSOR_EXTRACT_TIMEOUT=120

# Загрузка документов: предел размера файла — как PROCESSOR_MAX_FILE_MB в processor/.env;
# в PHP (Herd → PHP → Max upload size) upload_max_filesize и post_max_size должны быть не меньше
DOCUMENTS_MAX_FILE_MB=20
DOCUMENTS_UPLOADS_PER_MINUTE=30
DOCUMENTS_MAX_PER_USER=1000
DOCUMENTS_MAX_STORAGE_MB_PER_USER=2048
# документы с персональными данными удаляются через столько дней (php artisan schedule:work)
DOCUMENTS_RETENTION_DAYS=365
# false — фрагменты документов не уходят во внешнюю LLM ни при каком выборе пользователя
DOCUMENTS_LLM_ENABLED=true
# false — локальная LLM (Ollama, документ не покидает сервер); true — облачная (GigaChat). Как PROCESSOR_LLM_PROVIDER
DOCUMENTS_LLM_EXTERNAL=false

# Больше времени обработки документа (180 с), иначе долгую обработку возьмёт второй обработчик очереди
DB_QUEUE_RETRY_AFTER=240

# Выгрузка выборки документов за один раз
DOCUMENTS_MAX_EXPORT=1000

# Адреса обратного прокси через запятую (например, 172.18.0.1) — тогда в журнал пишется IP клиента;
# пусто — приложение доступно напрямую, заголовок X-Forwarded-For не учитывается
TRUSTED_PROXIES=

# Часовой пояс, в котором пользователю показывается время (в БД — UTC)
APP_DISPLAY_TIMEZONE=Europe/Moscow

# Для продакшена: APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=warning, SESSION_SECURE_COOKIE=true
