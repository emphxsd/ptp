# секреты и окружение
.env
.env.*
!.env.example

# зависимости и сборка
node_modules/
vendor/
__pycache__/
*.pyc
.venv/
venv/
dist/
build/

# IDE и системные файлы
.idea/
.vscode/
*.log
.DS_Store
Thumbs.db

# временные файлы Office и draw.io
~$*
*.bkp
*.dtmp

# реальные документы с персональными данными не коммитим
data/private/
uploads/
storage/app/

# отчёты тестов
.coverage
htmlcov/
.pytest_cache/

# сертификаты для GigaChat скачиваются с gosuslugi.ru
processor/certs/*
!processor/certs/README.txt

# синтетическая выборка генерируется заново (python -m evaluation.generate)
processor/evaluation/data/

# отчёты оценки могут содержать данные реальных документов; в git — только синтетические
processor/evaluation/reports/*
!processor/evaluation/reports/synthetic/
!processor/evaluation/reports/holdout/
