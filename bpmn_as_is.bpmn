<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="Collab_1"><bpmn:participant id="Pool_1" name="Ручная обработка документа (AS IS)" processRef="Process_AsIs"/></bpmn:collaboration>
<bpmn:process id="Process_AsIs" isExecutable="false">
<bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="Lane_1" name="Специалист">
<bpmn:flowNodeRef>S</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_2" name="Учётная ИС / БД">
<bpmn:flowNodeRef>A7</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S" name="Поступил документ">
<bpmn:outgoing>Flow_1</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:task id="A1" name="Получить документ (бумага, скан, PDF, DOCX)">
<bpmn:incoming>Flow_1</bpmn:incoming>
<bpmn:outgoing>Flow_2</bpmn:outgoing>
<bpmn:property id="Prop_A1" name="__targetRef_placeholder"/>
<bpmn:dataInputAssociation id="DIA_A1_0"><bpmn:sourceRef>D1</bpmn:sourceRef><bpmn:targetRef>Prop_A1</bpmn:targetRef></bpmn:dataInputAssociation>
</bpmn:task>
<bpmn:task id="A2" name="Определить вид документа">
<bpmn:incoming>Flow_2</bpmn:incoming>
<bpmn:outgoing>Flow_3</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="A3" name="Изучить документ, найти ключевые данные">
<bpmn:incoming>Flow_3</bpmn:incoming>
<bpmn:outgoing>Flow_4</bpmn:outgoing>
<bpmn:property id="Prop_A3" name="__targetRef_placeholder"/>
<bpmn:dataInputAssociation id="DIA_A3_0"><bpmn:sourceRef>D2</bpmn:sourceRef><bpmn:targetRef>Prop_A3</bpmn:targetRef></bpmn:dataInputAssociation>
</bpmn:task>
<bpmn:task id="A4" name="Вручную перенести данные в шаблон / таблицу">
<bpmn:incoming>Flow_4</bpmn:incoming>
<bpmn:incoming>Flow_7</bpmn:incoming>
<bpmn:outgoing>Flow_5</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="A5" name="Проверить корректность ввода">
<bpmn:incoming>Flow_5</bpmn:incoming>
<bpmn:outgoing>Flow_6</bpmn:outgoing>
<bpmn:dataOutputAssociation id="DOA_A5_0"><bpmn:targetRef>D3</bpmn:targetRef></bpmn:dataOutputAssociation>
</bpmn:task>
<bpmn:exclusiveGateway id="G1" name="Есть ошибки?">
<bpmn:incoming>Flow_6</bpmn:incoming>
<bpmn:outgoing>Flow_7</bpmn:outgoing>
<bpmn:outgoing>Flow_8</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:task id="A6" name="Ввести данные в форму учётной системы">
<bpmn:incoming>Flow_8</bpmn:incoming>
<bpmn:outgoing>Flow_9</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="A7" name="Сохранить запись в БД">
<bpmn:incoming>Flow_9</bpmn:incoming>
<bpmn:outgoing>Flow_10</bpmn:outgoing>
<bpmn:dataOutputAssociation id="DOA_A7_0"><bpmn:targetRef>DB</bpmn:targetRef></bpmn:dataOutputAssociation>
</bpmn:task>
<bpmn:endEvent id="E" name="Данные внесены">
<bpmn:incoming>Flow_10</bpmn:incoming>
</bpmn:endEvent>
<bpmn:dataObjectReference id="D1" name="Исходный документ" dataObjectRef="DO_D1"/><bpmn:dataObject id="DO_D1"/>
<bpmn:dataObjectReference id="D2" name="Перечень ключевых полей" dataObjectRef="DO_D2"/><bpmn:dataObject id="DO_D2"/>
<bpmn:dataObjectReference id="D3" name="Таблица с данными" dataObjectRef="DO_D3"/><bpmn:dataObject id="DO_D3"/>
<bpmn:dataStoreReference id="DB" name="БД учётной системы"/>
<bpmn:sequenceFlow id="Flow_1" sourceRef="S" targetRef="A1"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="A1" targetRef="A2"/>
<bpmn:sequenceFlow id="Flow_3" sourceRef="A2" targetRef="A3"/>
<bpmn:sequenceFlow id="Flow_4" sourceRef="A3" targetRef="A4"/>
<bpmn:sequenceFlow id="Flow_5" sourceRef="A4" targetRef="A5"/>
<bpmn:sequenceFlow id="Flow_6" sourceRef="A5" targetRef="G1"/>
<bpmn:sequenceFlow id="Flow_7" name="Да" sourceRef="G1" targetRef="A4"/>
<bpmn:sequenceFlow id="Flow_8" name="Нет" sourceRef="G1" targetRef="A6"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="A6" targetRef="A7"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="A7" targetRef="E"/>
</bpmn:process>
